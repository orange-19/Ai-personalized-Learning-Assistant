# Python Microservice Environment Configuration
# Save as: ppla/.env

# ═══════════════════════════════════════════════════════════════
# FLASK SERVER SETTINGS
# ═══════════════════════════════════════════════════════════════

PPLA_HOST=0.0.0.0
PPLA_PORT=5000
PPLA_DEBUG=false

# ═══════════════════════════════════════════════════════════════
# AI PROVIDER SELECTION
# ═══════════════════════════════════════════════════════════════

# Choose ONE provider: groq, openai, or anthropic
# Note: You can run without an API key - fallback to rule-based path generation

AI_PROVIDER=groq

# ═══════════════════════════════════════════════════════════════
# API KEYS
# ═══════════════════════════════════════════════════════════════

# For GROQ (Recommended - Free tier available)
# Get key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# For OpenAI (Paid)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_openai_key_here

# For Anthropic/Claude (Paid)
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# ═══════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════════════

CORS_ORIGIN=http://localhost:3000

# ═══════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════

PPLA_LOG_LEVEL=DEBUG
